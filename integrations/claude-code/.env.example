# Praesidio CC Plugin Configuration
# Copy this to .env in your project root (the directory you run Claude Code from).

# Praesidio API key (get from Praesidio dashboard → Agents → New Key)
PRAESIDIO_API_KEY=prs_local_your_key_here

# Praesidio backend WebSocket URL
PRAESIDIO_WS_URL=ws://localhost:8080/ws

# Verdict timeout in seconds (fail-open after this)
PRAESIDIO_CC_VERDICT_TIMEOUT=15

# Fail-open policy: true = allow on timeout/error, false = block
PRAESIDIO_CC_FAIL_OPEN=true
